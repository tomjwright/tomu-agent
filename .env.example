ANTHROPIC_API_KEY=
# Optional: override the default model
# TOMU_MODEL=claude-sonnet-4-6
# Optional: where memory is stored (default tomu.db in the current folder)
# TOMU_DB=tomu.db
# Optional: Google Calendar and Gmail (a Google OAuth "Desktop app" client), then run: uv run tomu-google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: web search (a free Brave Search API key from https://brave.com/search/api/)
# BRAVE_API_KEY=
# Optional: the Telegram gateway, then run: uv run tomu-telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER=
